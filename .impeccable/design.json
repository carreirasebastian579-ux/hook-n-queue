      "css": ":host{--bg:#0D0F0F;--surface:#141817;--surface2:#1B201F;--line:#242A29;--ink:#E4EAE8;--muted:#86918E;--accent:#3DBF8E;--accent-ink:#06120D;--accent-soft:rgba(61,191,142,.10)}.ds-msgs{font-family:Inter,system-ui,-apple-system,\"Segoe UI\",sans-serif;display:flex;flex-direction:column;gap:6px;width:280px;font-size:14px}.ds-msg{max-width:78%;padding:8px 12px;border-radius:14px;border-bottom-left-radius:4px;background:var(--surface2);color:var(--ink);align-self:flex-start}.ds-me{align-self:flex-end;background:var(--accent);color:var(--accent-ink);border-radius:14px;border-bottom-right-radius:4px}"
